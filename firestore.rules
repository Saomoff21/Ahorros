rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test ping collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Vaults collection and all subcollections for cross-device shared code access
    match /vaults/{vaultId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'description', 'amount', 'category', 'date'])
        && data.type in ['income', 'expense']
        && data.description is string && data.description.size() <= 200
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 100
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50));
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['userId', 'name', 'total', 'paid', 'startDate'])
        && data.name is string && data.name.size() <= 200
        && data.total is number && data.total >= 0
        && data.paid is number && data.paid >= 0
        && data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasAll(['userId', 'name', 'targetAmount', 'currentAmount'])
        && data.name is string && data.name.size() <= 150
        && data.targetAmount is number && data.targetAmount > 0
        && data.currentAmount is number && data.currentAmount >= 0;
    }

    function isValidRecurringPayment(data) {
      return data.keys().hasAll(['userId', 'name', 'amount', 'type', 'frequency', 'dueDay'])
        && data.name is string && data.name.size() <= 150
        && data.amount is number && data.amount > 0
        && data.type in ['income', 'expense']
        && data.frequency in ['MENSUAL', 'QUINCENAL', 'SEMANAL', 'ANUAL']
        && data.dueDay is number && data.dueDay >= 1 && data.dueDay <= 31;
    }

    // User Profiles & Vault Metadata
    match /users/{userId} {
      allow read, write: if true;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if true;
      }

      // Debts subcollection
      match /debts/{debtId} {
        allow read, write: if true;
      }

      // Savings Goals subcollection
      match /savingsGoals/{goalId} {
        allow read, write: if true;
      }

      // Recurring Payments subcollection
      match /recurringPayments/{recurringId} {
        allow read, write: if true;
      }
    }

    // Fast Cross-Device User Lookup Index
    match /users_index/{lookupKey} {
      allow read, write: if true;
    }
  }
}
